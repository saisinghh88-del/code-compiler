# ==============================================
# CodeMaster AI - Environment Configuration Example
# Copy this file to .env and fill in your values
# ==============================================

# --- Backend Configuration ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Supabase Configuration ---
# Public URL and Anon Key for client/frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Server-side Supabase Service Role (Optional, for backend admin tasks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# --- Code Execution Sandbox (Judge0) ---
# Supported providers: RapidAPI Judge0 or Self-hosted Judge0 CE
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-judge0-api-key-placeholder
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
# Use 'true' to allow safe simulated execution fallback when API key is not yet set
ALLOW_SANDBOX_FALLBACK=true

# --- AI Tutor Service (Gemini / OpenAI compatible) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-placeholder
OPENAI_API_KEY=your-openai-api-key-placeholder
AI_MODEL_NAME=gemini-1.5-flash

# --- Frontend API Endpoint ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
